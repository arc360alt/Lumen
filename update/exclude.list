# Paths that updates never touch (globs, relative to /; "*" also matches "/").
# Live-ISO-only files, and files the installer writes for each computer. Everything else from stage-root.sh is
# kept in step with the repository (files you've changed yourself are kept; the new version goes next to them as .lumennew).
etc/passwd
etc/shadow
etc/group
etc/gshadow
etc/hostname
etc/hosts
etc/locale.conf
etc/localtime
etc/vconsole.conf
etc/motd
etc/resolv.conf
etc/machine-id
etc/environment
etc/greetd/config.toml
etc/mkinitcpio.conf.d/archiso.conf
etc/mkinitcpio.d/*
etc/pacman.d/hooks/*
etc/sudoers.d/90-lumen-live
etc/ssh/sshd_config.d/10-archiso.conf
etc/systemd/journald.conf.d/volatile-storage.conf
etc/systemd/logind.conf.d/do-not-suspend.conf
etc/systemd/resolved.conf.d/archiso.conf
etc/systemd/system-generators/systemd-gpt-auto-generator
etc/systemd/system/choose-mirror.service
etc/systemd/system/*/choose-mirror.service
etc/systemd/system/livecd-*
etc/systemd/system/*/livecd-*
etc/systemd/system/pacman-init.service
etc/systemd/system/*/pacman-init.service
etc/systemd/system/etc-pacman.d-gnupg.mount
etc/systemd/system/lumen-live-setup.service
etc/systemd/system/*/lumen-live-setup.service
etc/systemd/system/getty@tty1.service.d/*
etc/systemd/system/cloud-init.target.wants/*
etc/systemd/system/multi-user.target.wants/hv_*
etc/systemd/system/multi-user.target.wants/vboxservice.service
etc/systemd/system/multi-user.target.wants/vmtoolsd.service
etc/systemd/system/multi-user.target.wants/vmware-vmblock-fuse.service
etc/systemd/system/multi-user.target.wants/sshd.service
etc/systemd/system/multi-user.target.wants/iwd.service
root/*
usr/local/bin/lumen-live-*
usr/local/bin/choose-mirror
usr/local/bin/Installation_guide
usr/local/bin/livecd-sound
usr/local/share/livecd-sound/*
