// Lumen's fastfetch look: the Lumen drop in its blue → purple colours. Applies to every user;
// your own ~/.config/fastfetch/config.jsonc wins over this one (fastfetch --gen-config makes one).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/lumen/fastfetch/logo.txt",
    "color": { "1": "38;2;124;199;255", "2": "38;2;58;123;255", "3": "38;2;138;77;255", "4": "97" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "38;2;58;123;255", "title": "38;2;124;199;255" },
    "separator": "  "
  },
  "modules": [
    "title", "separator",
    "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "de", "wm", "terminal",
    "cpu", "gpu", "memory", "swap", "disk", "localip", "battery",
    "break", "colors"
  ]
}
