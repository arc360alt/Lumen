{
  "name": "lumen-installer",
  "productName": "Install Lumen",
  "version": "1.0.0",
  "description": "The Lumen OS installer, built the same way as LiquidDesktop's own apps (Electron, plain JavaScript, Liquid Glass).",
  "main": "main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron . --test",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --test --devtools",
    "real": "env -u ELECTRON_RUN_AS_NODE electron .",
    "sync-liquid": "sh tools/sync-liquid.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.5"
  },
  "devDependencies": {
    "electron": "43.8.7"
  }
}
